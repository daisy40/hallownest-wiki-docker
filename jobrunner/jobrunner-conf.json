{
  "groups": {
    "basic": {
      "runners": 2,
      "include": ["*"],
      "low-priority": [
        "cirrusSearchLinksUpdate",
        "htmlCacheUpdate",
        "refreshLinks"
      ]
    }
  },

  "limits": {
    "attempts": { "*": 3 },
    "claimTTL": { "*": 3600 },
    "real":     { "*": 300 },
    "memory":   { "*": "300M" }
  },

  "redis": {
    "aggregators": ["valkey-jobs"],
    "queues": ["valkey-jobs"]
  },

  "dispatcher": "php /var/www/html/maintenance/run.php runJobs --type=%(type)x --maxtime=%(maxtime)x --memory-limit=%(maxmem)x --result=json"
}
